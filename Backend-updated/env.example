# Copy this file, rename it to .env, and fill in your own values
# Never share or push your .env file to GitHub

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000

# ── Aiven MySQL Database ──────────────────────────────────────────────────────
# Get these values from your Aiven console → Service → Connection Info
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb

# ── Aiven SSL (required for Aiven MySQL) ─────────────────────────────────────
# Path to the CA certificate downloaded from Aiven console
# Place the file in Backend-updated/ and set the path below
DB_SSL_CA_PATH=cacert.pem
# Set to "false" only for local dev without SSL; keep "true" for Aiven
DB_SSL_REJECT_UNAUTHORIZED=true
